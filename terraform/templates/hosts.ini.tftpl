# GENERATED by terraform — do not edit.
%{ if bastion_ip != "" ~}
# access through the bastion host ${bastion_ip}
%{ endif ~}
[control_plane]
control-plane ansible_host=${bastion_ip != "" ? control_plane.private_ip : control_plane.id} private_ip=${control_plane.private_ip}

[workers]
%{ for name, w in workers ~}
${name} ansible_host=${bastion_ip != "" ? w.private_ip : w.id} private_ip=${w.private_ip}
%{ endfor ~}

[k8s:children]
control_plane
workers

[k8s:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_key}
%{ if bastion_ip != "" ~}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="ssh -i ${ssh_key} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -W %h:%p ubuntu@${bastion_ip}"'
%{ else ~}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="aws ssm start-session --region ${region} --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"'
%{ endif ~}
aws_region=${region}
vpc_cidr=${vpc_cidr}
