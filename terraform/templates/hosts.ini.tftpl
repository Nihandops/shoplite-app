# GENERATED by terraform — do not edit.
[control_plane]
control-plane ansible_host=${control_plane.id} private_ip=${control_plane.private_ip}

[workers]
%{ for name, w in workers ~}
${name} ansible_host=${w.id} private_ip=${w.private_ip}
%{ endfor ~}

[k8s:children]
control_plane
workers

[k8s:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_key}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="aws ssm start-session --region ${region} --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"'
aws_region=${region}
vpc_cidr=${vpc_cidr}
